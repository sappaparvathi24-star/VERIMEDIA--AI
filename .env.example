# VeriMedia AI — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE variables (never prefix with VITE_ — never exposed to browser)
# ─────────────────────────────────────────────────────────────────────────────

# Gemini Intelligence API (Server-side only)
GEMINI_API_KEY=

# Supabase PostgreSQL & Storage (Free tier supported)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3 (Official free quota: 10,000 units/day)
YOUTUBE_API_KEY=

# Reddit Official API Client
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=verimedia-ai/1.0

# Google Custom Search / Image Discovery
# (Code reads GOOGLE_CSE_API_KEY and GOOGLE_CSE_CX — use these exact names)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Meta / Instagram Graph API (Professional accounts only)
INSTAGRAM_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# TikTok Developer API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X (formerly Twitter) Developer API
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Security & Proxy Settings (Required in Production)
SECRET_KEY=
API_KEY_SALT=
ADMIN_BOOTSTRAP_PASSWORD=
CORS_ORIGINS=*
MAX_UPLOAD_MB=100
DISCOVERY_TIMEOUT_MS=15000

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND variables — only VITE_* prefixed vars are bundled into the browser
# NEVER put server secrets here
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (leave empty for same-origin dev; set for Vercel→Render)
# Example: VITE_API_BASE_URL=https://verimedia-ai-2.onrender.com
VITE_API_BASE_URL=

# Supabase public config for frontend auth (anon key is safe for browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
